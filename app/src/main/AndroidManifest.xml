<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- neverForLocation: this app has no use for location, so scanning BLE must not
         require the location permission. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only used by the built-in rower simulator, which advertises a fake FTMS
         service so the BLE path can be tested without hardware. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Video row can stream http(s) sources (mp4/HLS/DASH). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service keeps the BLE session alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Saving a video offline runs as a foreground service so a long download
         survives the app being backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Stream URLs are user-supplied and frequently a local/LAN media server, which
         is usually plain http. Without this, http:// playback fails outright. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Fellwater"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <service
            android:name=".RowService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- singleTask: a link shared from YouTube reuses the running app (and its
             player) instead of opening a second copy inside YouTube's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Row to this video">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
